\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0bb5\u0bb4\u0bbf\u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0ba4\u0bcd\u0ba4\u0b95\u0bcd\u0b95 \u0ba8\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc8 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd\u0baa\u0bcb\u0ba4\u0bc1, \u200b\u200b\u0b8e\u0bb3\u0bbf\u0bae\u0bc8, \u0b92\u0bb4\u0bc1\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0baf\u0baa\u0bb0\u0bbf\u0b9a\u0bcb\u0ba4\u0ba9\u0bc8 \u0b86\u0b95\u0bbf\u0baf\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0b86\u0bb4\u0bae\u0bbe\u0ba9 \u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b9a\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0b95\u0bbf\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bca\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd \u0b9e\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0ba8\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bc1\u0bae\u0bcd, \u0b88\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bc1\u0bae\u0bcd, \u0b8e\u0baa\u0bcd\u0baa\u0bcb\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0bbe\u0bb1\u0bb5\u0bc1\u0bae\u0bcd \u0ba4\u0baf\u0bbe\u0bb0\u0bbe\u0b95\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.","language":"Tamil"}],"location":"3","is_layout":0,"released_on":2020,"genre_titles":"Entertainment","language":"Hindi","video_duration":162,"skip_season":1,"season_count":1,"media_type":0,"certificate":null,"is_imdb":0,"is_rottentomato":0,"rating_json":[{"agency":"IMDB","rating":"3"}],"is_paid":0,"thumbnail":"https:\/\/d1ov3fprdb67dw.cloudfront.net\/shows\/thumbnail\/15783391718883431_7499580monk_1.png","poster_url":"https:\/\/d1ov3fprdb67dw.cloudfront.net\/shows\/poster_url\/43810491718883432_postwee.jpg"},{"id":67,"video_id":58,"title":"Demo","banner_thumbnail":"https:\/\/d3u46owbs61oyy.cloudfront.net\/banner\/44393121720692392_70508491719913056_64462861714805759_National-Film-awards_3.png","category_id":"1","category_title":"Documentaries","banner_icon":"https:\/\/d1ov3fprdb67dw.cloudfront.net\/shows\/banner_icon\/70814531718883976_36863571714737854_title_logo_sansad_69.png","file_url":"","is_drm_protected":1,"vdc_id":"4020190_0_2299729954875412","banner_type":0,"show_id":67,"banner_url":"https:\/\/d3u46owbs61oyy.cloudfront.net\/banner\/17251411720692392_70508491719913056_64462861714805759_National-Film-awards_3.png","hyperlink":"","description":[{"content":"It\u2019s a spectacular journey that spans 80,000 km and spread across 5,000 years. It starts from the Indus Valley civilization and ends in the 17th century, across the length and breadth of India. This 26-part documentary series, The Sculptures of India, highlights early Indian art to give a perspective on ancient Indian philosophy as well as history.","language":"English"},{"content":"\u092f\u0939 \u090f\u0915 \u0936\u093e\u0928\u0926\u093e\u0930 \u092f\u093e\u0924\u094d\u0930\u093e \u0939\u0948 \u091c\u094b 80,000 \u0915\u093f\u092e\u0940 \u0924\u0915 \u092b\u0948\u0932\u0940 \u0939\u0941\u0908 \u0939\u0948 \u0914\u0930 5,000 \u0935\u0930\u094d\u0937\u094b\u0902 \u0924\u0915 \u092b\u0948\u0932\u0940 \u0939\u0941\u0908 \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0902\u0927\u0941 \u0918\u093e\u091f\u0940 \u0938\u092d\u094d\u092f\u0924\u093e \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0914\u0930 \u092a\u0942\u0930\u0947 \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 17\u0935\u0940\u0902 \u0936\u0924\u093e\u092c\u094d\u0926\u0940 \u092e\u0947\u0902 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 26-\u092d\u093e\u0917 \u0935\u093e\u0932\u0940 \u0935\u0943\u0924\u094d\u0924\u091a\u093f\u0924\u094d\u0930 \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e, \u0926 \u0938\u094d\u0915\u0932\u094d\u092a\u091a\u0930\u094d\u0938 \u0911\u092b \u0907\u0902\u0921\u093f\u092f\u093e, \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092d\u093e\u0930\u0924\u0940\u092f \u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0907\u0924\u093f\u0939\u093e\u0938 \u092a\u0930 \u090f\u0915 \u092a\u0930\u093f\u092a\u094d\u0930\u0947\u0915\u094d\u0937\u094d\u092f \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u0932\u093e \u092a\u0930 \u092a\u094d\u0930\u0915\u093e\u0936 \u0921\u093e\u0932\u0924\u0940 \u0939\u0948\u0964","language":"Hindi"},{"content":"\u0b87\u0ba4\u0bc1 80,000 \u0b95\u0bbf\u0bae\u0bc0 \u0ba8\u0bc0\u0bb3\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 5,000 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd \u0baa\u0bb0\u0bb5\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0b85\u0bb1\u0bcd\u0baa\u0bc1\u0ba4\u0bae\u0bbe\u0ba9 \u0baa\u0baf\u0ba3\u0bae\u0bcd. \u0b87\u0ba4\u0bc1 \u0b9a\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 \u0b9a\u0bae\u0bb5\u0bc6\u0bb3\u0bbf \u0ba8\u0bbe\u0b95\u0bb0\u0bbf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bbf 17 \u0b86\u0bae\u0bcd \u0ba8\u0bc2\u0bb1\u0bcd\u0bb1\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0b9f\u0bc8\u0b95\u0bbf\u0bb1\u0ba4\u0bc1, \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0ba8\u0bc0\u0bb3\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0b95\u0bb2\u0bae\u0bcd \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd. \u0b87\u0ba8\u0bcd\u0ba4 26-\u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0b86\u0bb5\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0ba4\u0bcd \u0ba4\u0bca\u0b9f\u0bb0\u0bcd, \u0ba4\u0bbf \u0bb8\u0bcd\u0b95\u0bb2\u0bcd\u0baa\u0bcd\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd\u0bb8\u0bcd \u0b86\u0b83\u0baa\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe, \u0baa\u0ba3\u0bcd\u0b9f\u0bc8\u0baf \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bcb\u0b95\u0bcd\u0b95\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95 \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0b95\u0bbe\u0bb2 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf \u0b95\u0bb2\u0bc8\u0baf\u0bc8 \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.","language":"Tamil"}],"location":"3","is_layout":0,"released_on":2020,"genre_titles":"History","language":"Hindi","video_duration":1432,"skip_season":0,"season_count":1,"media_type":0,"certificate":null,"is_imdb":0,"is_rottentomato":0,"rating_json":[{"agency":"IMDB","rating":"3.5"}],"is_paid":1,"thumbnail":"https:\/\/d1ov3fprdb67dw.cloudfront.net\/shows\/thumbnail\/36232191718883976_53847551714737854_vertical_69__1_.png","poster_url":"https:\/\/d1ov3fprdb67dw.cloudfront.net\/shows\/poster_url\/1279701718883976_1363281718003691_720x405_horizontal_69__1___1_.png"}]